     c_args: drivers_cflags,
     dependencies: deps,
-    link_with: libfprint_private,
+    link_with: [libfprint_private, libsigfm],
     install: false)
 
 mapfile = files('libfprint.ver')[0]
@@ -274,8 +320,8 @@ libfprint = shared_library(versioned_libname.split('lib')[1],
     version: libversion,
